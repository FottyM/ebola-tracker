{
  "name": "ebola-tracker",
  "version": "1.0.0",
  "license": "GPL-2.0-only",
  "author": "Fortunat Mutunda <fotimutunda@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vp node server.js",
    "build": "vp build --outDir dist/client && vp build --ssr src/entry-server.js --outDir dist/server",
    "build:pages": "vp build --outDir dist",
    "preview": "vp preview --outDir dist",
    "sync": "vp node scripts/sync-data.js",
    "start": "NODE_ENV=production vp node server.js",
    "prepare": "vp config"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/charts": "^0.14.0",
    "hono": "^4.13.2",
    "leaflet": "^1.9.4",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}

{
  "name": "ebola-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp node server.js",
    "build": "vp build --outDir dist/client && vp build --ssr src/entry-server.js --outDir dist/server",
    "start": "NODE_ENV=production vp node server.js",
    "prepare": "vp config"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/charts": "^0.14.0",
    "hono": "^4.13.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
